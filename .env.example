# Backend
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=1d

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mediflow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Keycloak (optional)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=mediflow
KEYCLOAK_CLIENT=mediflow-client
KEYCLOAK_SECRET=your-secret

# FHIR Server URL
FHIR_SERVER_URL=http://fhir-server:8080

# AI (OpenAI/Claude)
OPENAI_API_KEY=your_openai_key
CLAUDE_API_KEY=your_claude_key

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_FHIR_URL=http://localhost:3000/fhir