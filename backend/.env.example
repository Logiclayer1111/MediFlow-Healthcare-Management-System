
# -------------------- SERVER --------------------
PORT=3000
NODE_ENV=development   # development | staging | production
APP_NAME=MediFlow
APP_URL=http://localhost:3000

# -------------------- JWT AUTHENTICATION --------------------
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION=1d                 # 1d, 7d, 30d, etc.
JWT_REFRESH_SECRET=your_refresh_secret
JWT_REFRESH_EXPIRATION=7d

# -------------------- DATABASE (PostgreSQL) --------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mediflow
DB_SSL=false                       # set to true for production (SSL/TLS)
DB_LOGGING=false                   # enable SQL query logging (dev only)
DB_SYNCHRONIZE=false               # never true in production (use migrations)
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000

# -------------------- REDIS (Caching & Session) --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                     # optional, leave empty if no password
REDIS_DB=0
REDIS_TLS=false

# -------------------- KEYCLOAK (SSO / OAuth2) --------------------
KEYCLOAK_ENABLED=false              # set true to enable SSO
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=mediflow
KEYCLOAK_CLIENT=mediflow-backend
KEYCLOAK_SECRET=your_keycloak_client_secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# -------------------- FHIR SERVER (Interoperability) --------------------
FHIR_SERVER_URL=http://fhir-server:8080/fhir
FHIR_SERVER_AUTH_TOKEN=            # Bearer token if secured
FHIR_SERVER_TIMEOUT=30000

# -------------------- HL7 & CCDA --------------------
HL7_LISTENER_PORT=2575              # port for HL7 v2 MLLP listener (if used)
CCDA_IMPORT_PATH=./uploads/ccda

# -------------------- AI & LLM (OpenAI / Claude / LangChain) --------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4                  # or gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-opus-20240229

# For local LLM via Ollama / LlamaIndex (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Vector DB for RAG (pgvector) – uses same PostgreSQL DB
PGVECTOR_ENABLED=true
PGVECTOR_DIMENSION=1536             # OpenAI embedding dimension

# -------------------- EMAIL (SMTP) --------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                   # true for 465, false for 587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=no-reply@mediflow.com

# -------------------- FILE STORAGE --------------------
STORAGE_DRIVER=local                # local | s3 | gcs
STORAGE_PATH=./uploads
# For S3
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_BUCKET=mediflow-assets

# -------------------- LOGGING --------------------
LOG_LEVEL=info                      # error | warn | info | debug | verbose
LOG_FORMAT=json                     # json | simple
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=100m
LOG_MAX_FILES=7

# -------------------- SECURITY & COMPLIANCE (HIPAA) --------------------
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=180
ENCRYPTION_KEY=your_32_byte_encryption_key_here   # used for PII/PHI encryption
SALT_ROUNDS=12

# -------------------- BILLING / INSURANCE --------------------
CLAIM_AUTO_SUBMIT=false
INSURANCE_VALIDATION_URL=https://insurance-api.example.com/validate
INSURANCE_API_KEY=your_insurance_api_key

# -------------------- APPOINTMENT SCHEDULING --------------------
APPOINTMENT_REMINDER_HOURS=24
APPOINTMENT_MAX_DAYS_AHEAD=90
CALENDAR_SYNC_ENABLED=false
CALENDAR_PROVIDER=google           # google | outlook | none
GOOGLE_CALENDAR_CLIENT_ID=your_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_client_secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/oauth2callback

# -------------------- PATIENT PORTAL --------------------
PORTAL_BASE_URL=http://localhost:3001
PORTAL_TOKEN_EXPIRY=30m
PORTAL_ENABLE_SMS=false
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth
TWILIO_PHONE_NUMBER=+1234567890

# -------------------- DICOM (Medical Imaging) --------------------
DICOM_ENABLED=false
DICOM_WADO_URI=http://dicom-server:8080/wado
DICOM_STUDY_URI=http://dicom-server:8080/studies

# -------------------- PERFORMANCE & RATE LIMITING --------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CACHE_TTL=300                       # default cache TTL in seconds

# -------------------- FEATURE TOGGLES (for gradual rollout) --------------------
FEATURE_AI_DIAGNOSIS=false
FEATURE_TELEHEALTH=false
FEATURE_PRESCRIPTION_EPRESCRIBE=true
FEATURE_PATIENT_MESSAGING=true

# -------------------- INTEGRATION ENDPOINTS --------------------
LAB_SYSTEM_URL=http://lab-api.example.com
LAB_SYSTEM_API_KEY=your_lab_api_key
PHARMACY_SYSTEM_URL=http://pharmacy-api.example.com
PHARMACY_SYSTEM_API_KEY=your_pharmacy_key

# -------------------- MISC --------------------
DEFAULT_TIMEZONE=UTC
DATE_FORMAT=YYYY-MM-DD
CURRENCY=USD